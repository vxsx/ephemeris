<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>name.vadim.ephemeris</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>/Users/vadim/work/ephemeris/scripts/weekly.sh</string>
    </array>

    <!-- Saturdays 08:00 Europe/Zurich (system-local time, which is what
         launchd uses). Weekday 6 = Saturday; launchd counts 0/7 as Sunday. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>6</integer>
        <key>Hour</key><integer>8</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <!-- If the Mac is asleep on Saturday at 08:00, launchd fires the job on
         wake. If the Mac is off all weekend, the week is skipped. -->
    <key>RunAtLoad</key><false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/vadim</string>
        <key>PATH</key>
        <string>/Users/vadim/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/vadim/work/ephemeris</string>

    <key>StandardOutPath</key>
    <string>/Users/vadim/work/ephemeris/.logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/vadim/work/ephemeris/.logs/launchd.err.log</string>
</dict>
</plist>
